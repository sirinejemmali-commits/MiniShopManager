<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:padding="14dp"
    android:gravity="center_vertical"
    android:background="@drawable/bg_carte"
    android:elevation="2dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/imgProduit"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:padding="11dp"
        android:background="@drawable/bg_icone"
        android:layout_marginEnd="16dp"
        android:src="@mipmap/ic_launcher" />

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvNomProduit"
            android:text="Nom du produit"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#2C1E16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="En stock • Ajouter au panier"
            android:textSize="12sp"
            android:textColor="#8C7A6B"
            android:layout_marginTop="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvPrixProduit"
        android:text="120 DT"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#8A5A2B"
        android:background="#F5EBE0"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>